{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Shared Renovate policy for alunduil's repositories.",
  "extends": [
    "config:best-practices",
    "security:openssf-scorecard",
    "customManagers:githubActionsVersions"
  ],
  "timezone": "Europe/London",
  "reviewers": ["alunduil"],
  "labels": ["dependencies"],
  "gitIgnoredAuthors": [
    "342169994+alunduil-hook-fix[bot]@users.noreply.github.com"
  ],
  "pre-commit": {
    "enabled": true
  },
  "minimumReleaseAge": "3 days",
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "osvVulnerabilityAlerts": true,
  "packageRules": [
    {
      "description": "These update types carry no release timestamp, so the release-age wait would hold them forever without opening a PR",
      "matchUpdateTypes": [
        "pin",
        "pinDigest",
        "digest",
        "lockFileMaintenance",
        "lockfileUpdate",
        "rollback",
        "bump",
        "replacement"
      ],
      "minimumReleaseAge": null
    },
    {
      "description": "Pin dev container images, which docker:pinDigests leaves unpinned because the dev container CLI rejects tag@digest on features",
      "matchManagers": ["devcontainer"],
      "matchDepTypes": ["image"],
      "pinDigests": true
    },
    {
      "description": "mise lock generates these files; the mise manager regenerates them with the digest that mise.lock records",
      "matchManagers": ["pep621"],
      "matchFileNames": [".mise/locks/**"],
      "enabled": false
    }
  ]
}
